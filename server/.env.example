# ================================================================
#  DropKE — Server Environment Variables
#  Copy this file to .env and fill in your values
# ================================================================

# ----------------------------------------------------------------
# SUPABASE DATABASE (Free cloud PostgreSQL)
# Steps:
#  1. Go to https://supabase.com and create a free account
#  2. Click "New Project" — name it dropshipping-ke
#  3. Choose a strong DB password and save it
#  4. Wait ~2 min for project to be ready
#  5. Go to: Project Settings → Database → Connection String → URI
#  6. Copy the URI and paste below (replace [YOUR-PASSWORD])
# ----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Supabase also gives you these (Settings → API):
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# ----------------------------------------------------------------
# JWT SECRET — any long random string
# ----------------------------------------------------------------
JWT_SECRET="change-this-to-a-very-long-random-string-abc123xyz456"

# Server port
PORT=5000

# Frontend URL
CLIENT_URL="http://localhost:3000"

# ----------------------------------------------------------------
# ADMIN CREDENTIALS
# Edit then run: node src/prisma/seed.js
# ----------------------------------------------------------------
ADMIN_NAME="Your Name"
ADMIN_EMAIL="your@email.com"
ADMIN_PASSWORD="YourStrongPassword@123"
ADMIN_PHONE="+254700000000"

# ----------------------------------------------------------------
# COMPANY INFO (used in emails and footer)
# ----------------------------------------------------------------
COMPANY_NAME="DropKE"
COMPANY_EMAIL="info@dropke.co.ke"
COMPANY_PHONE="+254 700 000 000"
COMPANY_WHATSAPP="+254700000000"
COMPANY_ADDRESS="Nairobi, Kenya"

# ----------------------------------------------------------------
# EMAIL — Gmail App Password
#  1. Use a Gmail account
#  2. Go to: https://myaccount.google.com/apppasswords
#  3. Generate App Password → select "Mail"
#  4. Paste the 16-character password below
# ----------------------------------------------------------------
EMAIL_USER="yourgmail@gmail.com"
EMAIL_PASS="xxxx-xxxx-xxxx-xxxx"
ADMIN_EMAIL_NOTIFY="yourgmail@gmail.com"

# ----------------------------------------------------------------
# SAFARICOM M-PESA DARAJA API
#  1. Go to: https://developer.safaricom.co.ke
#  2. Create free account → New App
#  3. Copy Consumer Key and Secret below
#  Sandbox shortcode: 174379 (use for testing)
# ----------------------------------------------------------------
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_CALLBACK_URL="https://YOUR-NGROK-URL.ngrok.io/api/payments/mpesa/callback"

# ----------------------------------------------------------------
# AFRICASTALKING SMS
#  1. Go to: https://account.africastalking.com
#  2. Create account → API Key
# ----------------------------------------------------------------
AT_API_KEY="your-africastalking-key"
AT_USERNAME="sandbox"

# ----------------------------------------------------------------
# CLOUDINARY (Product image uploads)
#  1. Go to: https://cloudinary.com (free account)
#  2. Copy Cloud Name, API Key, API Secret from dashboard
# ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ----------------------------------------------------------------
# GOOGLE OAUTH
#  1. Go to: https://console.cloud.google.com
#  2. Create project → APIs & Services → Credentials
#  3. Create OAuth 2.0 Client ID (Web application)
#  4. Add http://localhost:3000 to Authorized JavaScript origins
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
